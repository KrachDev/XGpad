<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="XGpad.MainWindow"
        Title="XGpad">
        <Grid Background="#FF191717">

                <!-- Top Bar -->

                <Border Height="50" VerticalAlignment="Top" Background="#FF1C2226">

                        <StackPanel Orientation="Horizontal"  Margin="10,0">

                                <Button VerticalAlignment="Center" Width="152" Height="32" Content="Joystck Retrive" Foreground="AliceBlue" Click="Button_OnClick"/>

                        </StackPanel>

                </Border>


                <TabControl x:Name="JoyStack"  VerticalAlignment="Top" Margin="0,50,0,0">
                
                </TabControl>

        </Grid>
</Window>
